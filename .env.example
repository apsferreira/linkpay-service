# Banco de dados
DATABASE_URL=postgres://postgres:***@localhost:5432/linkpay_db

# Redis (usado para rate limiting e idempotência de webhook)
REDIS_URL=redis://localhost:***@localhost:5672/

# JWT (mesmo secret do auth-service)
JWT_SECRET=your-jwt-secret

# Asaas
ASAAS_API_KEY=your-asaas-api-key
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=your-webhook-secret
# Janela (s) do timestamp do webhook Asaas p/ anti-replay (default: 300 = 5 min)
ASAAS_WEBHOOK_MAX_AGE_SECONDS=300

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# RabbitMQ (opcional)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Integração
NOTIFICATION_SERVICE_URL=http://notification-service:3030
SERVICE_TOKEN=your-service-token
BASE_URL=https://pay.institutoitinerante.com.br

# Servidor
PORT=3020
CORS_ORIGINS=http://localhost:5173
